{
  "name": "Vibe or Die Network",
  "short_name": "VOD",
  "description": "A decentralized social network for artists and fans. Share music, art, and connect directly with the community on a P2P blockchain.",
  "id": "/",
  "start_url": "/",
  "display": "standalone",
  "note_handling": {
    "action": "/new-post"
  },
  "scope": "/",
  "prefer_related_applications": false,
  "related_applications": [],
  "iarc_rating_id": "",
  "background_color": "#0b0c10",
  "theme_color": "#66fcf1",
  "orientation": "any",
  "categories": ["music", "social", "entertainment"],
  "icons": [
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/mobile-screenshot-1.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "screenshots/mobile-screenshot-2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "screenshots/mobile-screenshot-3.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "screenshots/mobile-screenshot-4.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "lang": "en-US",
  "dir": "ltr",
  "scope_extensions": [],
  "shortcuts": [
    {
      "name": "Upload Track",
      "short_name": "Upload",
      "description": "Upload a new track to VOD",
      "url": "/upload",
      "icons": [
        {
          "src": "icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/wav": [
          ".wav"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+vod",
      "url": "/?link=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "VOD Player",
      "description": "Quick access to the music stream.",
      "tag": "player",
      "template_url": "/widget",
      "has_required_properties": false
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}